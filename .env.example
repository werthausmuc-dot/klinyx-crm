# Copy this file to .env and adjust the values before running the app.

# Port the server listens on.
PORT=3000

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Set to "true" once the app is served over HTTPS (behind nginx/caddy with a
# certificate, or a platform that terminates TLS for you). When true, login
# cookies are marked Secure and are only sent over HTTPS.
COOKIE_SECURE=false

# Optional. Leave unset when you're on a real server/VPS with a persistent
# disk — the app will just use data/db.json (no external account needed).
#
# Set this when your host's filesystem is ephemeral (e.g. Render's free
# plan wipes local files on every restart/redeploy). Get a free-forever
# connection string from a MongoDB Atlas M0 cluster (no card required):
# https://www.mongodb.com/cloud/atlas/register — the app switches to it
# automatically as soon as this is set. Requires the host's build step to
# run "npm install" so the mongodb package actually gets installed.
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/

# Optional. Telegram bot for task-assignment reminders (see README section
# "Telegram-бот нагадувань"). Get a token from @BotFather in Telegram.
# TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Optional but recommended once TELEGRAM_BOT_TOKEN is set — a random string
# that stops strangers from sending fake requests to your webhook endpoint.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# TELEGRAM_WEBHOOK_SECRET=change-this-to-a-long-random-string
